# Hermes API server connection (keep this on the gateway host; never expose it to the browser)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-your-hermes-api-server-key

# One-time device pairing code. Use a long random value in production.
PAIRING_CODE=replace-with-a-long-random-pairing-code

# Gateway
PORT=8643
WEB_ORIGIN=http://localhost:4173
COOKIE_SECURE=false
